# 거래 API 구현 시 사용할 PostgreSQL 및 Redis 연결 주소
# 로컬 개발용 값. 비밀번호를 바꾸면 두 항목을 함께 바꿉니다.
POSTGRES_PASSWORD=finguard_local
DATABASE_URL=postgresql://finguard:finguard_local@127.0.0.1:5432/finguard
REDIS_URL=redis://127.0.0.1:6379/0

# 외부 모델을 사용하는 조사 에이전트 구현 시 발급받은 키
LLM_API_KEY=

# 거래 점수 API가 시작할 때 읽을 로컬 모델 파일
SCORING_MODEL_PATH=artifacts/behavior_ablation/selected_model.joblib
